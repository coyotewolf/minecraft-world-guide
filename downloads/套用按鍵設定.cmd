@echo off
setlocal
chcp 65001 >nul
set "IAA_KEY_SCRIPT=%~f0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:IAA_KEY_SCRIPT);$m='#<IAA_POWERSHELL>';& ([scriptblock]::Create($s.Substring($s.LastIndexOf($m)+$m.Length)))"
set "IAA_RESULT=%errorlevel%"
if not defined IAA_KEYS_NO_PAUSE pause
exit /b %IAA_RESULT%
#<IAA_POWERSHELL>
$ErrorActionPreference='Stop'
$temp=$null
try {
    $folder=[IO.Path]::GetDirectoryName($env:IAA_KEY_SCRIPT)
    $target=Join-Path $folder 'options.txt'
    if(-not [IO.File]::Exists($target)) { throw '找不到同一層的 options.txt。請將腳本放進模組包的 .minecraft 資料夾。' }
    $processes=@(Get-CimInstance Win32_Process -Filter "Name='javaw.exe' OR Name='java.exe'")
    foreach($p in $processes) {
        if(-not $p.CommandLine) { throw '無法確認 Minecraft 是否已關閉；請正常關閉遊戲後重試。' }
        if($p.CommandLine -match 'minecraft|forge|launchwrapper' -and
           $p.CommandLine.IndexOf($folder,[StringComparison]::OrdinalIgnoreCase) -ge 0) {
            throw '此模組包的 Minecraft 仍在執行，請正常關閉遊戲後再次雙擊腳本。'
        }
    }
    $before=[IO.File]::ReadAllBytes($target)
    $encoding=New-Object Text.UTF8Encoding($false,$true)
    $text=$encoding.GetString($before)
    $preset=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')) | ConvertFrom-Json
    $map=New-Object 'Collections.Generic.Dictionary[string,string]' ([StringComparer]::Ordinal)
    foreach($p in $preset.PSObject.Properties) { $map.Add($p.Name,[string]$p.Value) }
    $state=@{Changed=0;Matched=0}
    $pattern='(?m)^(key_[^:\r\n]+):([^\r\n]*)'
    $updated=[regex]::Replace($text,$pattern,[Text.RegularExpressions.MatchEvaluator]{
        param($m)
        $key=$m.Groups[1].Value
        if(-not $map.ContainsKey($key)) { return $m.Value }
        $state.Matched++
        if($m.Groups[2].Value -eq $map[$key]) { return $m.Value }
        $state.Changed++
        return $key+':'+$map[$key]
    })
    if($state.Matched -eq 0) { throw '未找到適用的按鍵設定。請確認這是帝國紀元 1.20.1 的 options.txt。' }
    if($state.Changed -eq 0) { Write-Host '按鍵已是目前版本，不需要修改。' -ForegroundColor Green; exit 0 }
    $after=$encoding.GetBytes($updated)
    # Preserve every non-binding byte, newline convention, and any UTF-8 BOM.
    $nonKeyPattern='(?m)^key_[^\r\n]*(?:\r?\n|$)'
    if([regex]::Replace($text,$nonKeyPattern,'') -cne [regex]::Replace($updated,$nonKeyPattern,'')) {
        throw '其他設定驗證失敗，原檔未修改。'
    }
    $temp=Join-Path $folder ('options.keys-'+[guid]::NewGuid().ToString('N')+'.tmp')
    $backup=Join-Path $folder ('options.backup-'+(Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+[guid]::NewGuid().ToString('N').Substring(0,8)+'.txt')
    [IO.File]::WriteAllBytes($temp,$after)
    if([Convert]::ToBase64String([IO.File]::ReadAllBytes($target)) -cne [Convert]::ToBase64String($before)) {
        throw 'options.txt 正被其他程式修改，原檔未修改；請關閉遊戲後重試。'
    }
    [IO.File]::Replace($temp,$target,$backup)
    $temp=$null
    Write-Host ('完成！已更新 '+$state.Changed+' 項按鍵；畫面、音效、語言與資源包設定均保留。') -ForegroundColor Green
    Write-Host ('原檔備份：'+$backup)
    Write-Host '重新啟動遊戲即可使用。龍族技能請開啟 Num Lock。'
    exit 0
} catch {
    Write-Host ('未套用：'+$_.Exception.Message) -ForegroundColor Red
    exit 1
} finally {
    if($temp -and [IO.File]::Exists($temp)) { Remove-Item -LiteralPath $temp -Force }
}
